  <picture>
    <source type="image/webp" srcset="/es/assets/claude-code-1-480w.webp 480w, /es/assets/claude-code-1-960w.webp 960w, /es/assets/claude-code-1-1440w.webp 1440w" sizes="(max-width: 600px) 100vw, 600px">
